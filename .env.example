# PostgreSQL database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geovision_ai
DB_USER=postgres
DB_PASSWORD=replace_with_your_database_password

# Copernicus Data Space credentials
COPERNICUS_CLIENT_ID=replace_with_your_client_id
COPERNICUS_CLIENT_SECRET=replace_with_your_client_secret

# Frontend origin used by authentication origin validation and CORS
FRONTEND_ORIGIN=http://127.0.0.1:5501

# Set true only when serving the application over HTTPS
COOKIE_SECURE=false
